# Portas
OPENWEBUI_PORT=3000

# Chave para autenticação entre serviços (pode ser qualquer string)
ROUTER_API_KEY=sk-example-key

# DeepSeek API (paga, barata)
DEEP_SEEK_API=sk-sua-chave-aqui

# Google Gemini (gratuita, para visão)
GEMINI_API_KEY=AIza...

# Brave Search (gratuita, para pesquisa web)
BRAVE_SEARCH_API_KEY=BS...

# Chave secreta do Open WebUI (gerada aleatoriamente)
WEBUI_SECRET_KEY=sua-chave-secreta-aqui

# Senha inicial do 9Router
INITIAL_PASSWORD=123456
